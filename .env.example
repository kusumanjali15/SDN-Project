# Machine-specific settings. Copy to .env and edit:   cp .env.example .env
# .env is never committed. Use absolute paths or ~ (expanded to your home,
# also under sudo). Leave a value empty to use the default shown.

# Python virtual environment that has Ryu installed (used by start_controller.sh)
# Default: ~/venvs/ryu-py310
SDN_VENV=

# Folder for shared runtime files: eve.json, blocked_ips.txt, suricata_port.txt ...
# Default: /tmp
SDN_RUNTIME_DIR=

# Folder for experiment logs (events.jsonl etc.). Default: <repo>/logs
SDN_LOG_DIR=

# Trained models and datasets. Defaults: <repo>/ml/models/trained, <repo>/ml/data/datasets
SDN_MODEL_DIR=
SDN_DATASET_DIR=

# OpenFlow port the controller listens on. Default: 6653
SDN_CONTROLLER_PORT=

# Interface CICFlowMeter sniffs for live features (the Suricata mirror), e.g. suricata-eth0
SDN_MIRROR_IFACE=

# --- Enforcement policy (defaults shown in brackets) ---
# Which evidence may block: signature | ml | hybrid   [hybrid]
SDN_POLICY_MODE=
# scoped = drop (src, dst, protocol); blanket = drop all traffic of the host   [scoped]
SDN_BLOCK_SCOPE=
# Block lifetime in seconds, 0 = never expire   [120]
SDN_BLOCK_HARD_TIMEOUT=
# Repeat offenders: timeout x multiplier per offence, capped   [2.0, 900]
SDN_BLOCK_REPEAT_MULTIPLIER=
SDN_BLOCK_MAX_TIMEOUT=
# ML persistence: r positives within window seconds   [3, 10]
SDN_PERSISTENCE_R=
SDN_PERSISTENCE_WINDOW=
# Random-forest confidence for an ML positive   [0.60]
SDN_ML_CONFIDENCE=
# Approved Suricata SIDs for automatic blocking   [config/auto_block_sids.txt]
SDN_AUTO_BLOCK_SIDS_FILE=
